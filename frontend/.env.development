# Loaded by `vite dev` only — never by `vite build`.
# In development the UI is on :5173 and the API on :8000, so it needs an
# absolute URL and the backend's CORS middleware allows the origin.
# Production builds deliberately leave VITE_API_URL unset: the bundle is served
# from the same origin as the API, so a relative base is correct.
VITE_API_URL=http://localhost:8000

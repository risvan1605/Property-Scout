# ─── Gemini LLM ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini 2.0/2.5 Flash are not served to new API keys. Flash-Lite is the
# default: same tool-routing accuracy here, ~1.3s per call, and a much larger
# free-tier daily quota than gemini-3.6-flash (20 requests/day).
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini 3.x thinks by default, costing ~20s per call. "low" keeps it near 2s.
LLM_THINKING_LEVEL=low
LLM_TEMPERATURE=0.2

# ─── Google Calendar (Service Account) ───────────────────────────────────────
# 1. Google Cloud project -> enable the Calendar API
# 2. Create a service account -> download its JSON key to the path below
# 3. Share your calendar with the service account's email ("Make changes to events")
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
# On a platform with no filesystem to put a key on (Railway, Fly, Heroku),
# paste the key's JSON contents here instead. main.py writes it to
# GOOGLE_SERVICE_ACCOUNT_FILE at startup; the key file itself is
# .dockerignore'd and never enters the image.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# SMTP_PASS must be a Gmail App Password, not your account password.
SMTP_HOST=smtp.gmail.com
# 587 is STARTTLS, 465 is implicit TLS. Use 465 when the host blocks outbound
# 587 — a common anti-spam measure on PaaS providers, which shows up as a
# connection timeout rather than an auth error.
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Retrieval & POI enrichment (optional overrides) ─────────────────────────
# Cosine similarity below this counts as "no data" rather than a weak answer.
RAG_MIN_SIMILARITY=0.50
# POI lookups are live Overpass round trips, so they are capped and, by
# default, warmed in the background instead of blocking a chat turn.
ENRICH_MAX_LISTINGS=3
ENRICH_SHORTLIST_WITH_POIS=false
PREFETCH_POIS_IN_BACKGROUND=true
MCP_MAX_POI_TYPES=4
MCP_CIRCUIT_BREAK_SECONDS=300
# Comma-separated Overpass endpoints. Leave blank to use the defaults in
# config.py (overpass-api.de, then maps.mail.ru). Only override with a mirror
# that carries WORLDWIDE data — a regional mirror answers 200 with zero
# elements for Bengaluru, which reads as "nothing nearby" instead of an error.
OSM_OVERPASS_ENDPOINTS=
# Budget for the background POI warm-up. It blocks nobody, so it is far more
# generous than the foreground ENRICH_TIME_BUDGET_SECONDS — a point costs one
# Overpass round trip per POI type, and those run from ~2s to ~30s under load.
PREFETCH_TIME_BUDGET_SECONDS=240

# ─── Email over HTTPS (when the host blocks SMTP) ────────────────────────────
# Many hosts block outbound SMTP on every port, which shows up as a connection
# timeout rather than an auth error. Setting either key switches delivery to
# that provider's HTTPS API, which no host blocks. SMTP stays the default and
# works fine locally.
#   Brevo  — 300/day free, sends to any recipient once the sender is verified
#   Resend — needs a verified domain to send anywhere but your own address
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=your_verified_sender@example.com   # defaults to SMTP_USER
# EMAIL_FROM_NAME=Property Scout

# ─── Text-to-Speech (ElevenLabs) ─────────────────────────────────────────────
# Without a key the app falls back to the browser's built-in voice.
# Get one at elevenlabs.io -> Profile -> API Keys.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Free accounts can only use PREMADE voices over the API, not Voice Library
# ones (those return HTTP 402). Verified working on the free tier:
#   Sarah EXAVITQu4vr4xnSDxMaL | Jessica cgSgspJ2msm6clMCkdW9
#   Brian nPczCjzI2devNBz1zQrb | George  JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
